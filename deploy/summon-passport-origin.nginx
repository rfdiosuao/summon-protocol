# Direct TLS endpoint for constrained Passport hardware. It avoids the CDN
# WebSocket edge while keeping the public website on its existing HTTPS route.
server {
    listen 30067 ssl;
    listen [::]:30067 ssl;
    server_name summon.entermodetwo.com;

    ssl_certificate /etc/letsencrypt/live/summon.entermodetwo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/summon.entermodetwo.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SUMMON_PASSPORT:1m;
    ssl_session_timeout 10m;

    location /v1/passport/connect {
        proxy_pass http://127.0.0.1:8842;
        proxy_http_version 1.1;
        proxy_set_header Host summon.entermodetwo.com;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
